{
  "name": "@4adra/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de 4adra: Cloudflare Worker sobre Clean Architecture + DDD Lite.",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{ts,mts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{ts,mts}\"",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.mts",
    "test:contract": "vitest run -c vitest.contract.config.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types --env-file=.dev.vars.example",
    "db:migrate:local": "wrangler d1 migrations apply 4adra-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply 4adra-db --remote",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "better-auth": "^1.7.20",
    "hono": "^4.13.18",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@vitest/coverage-istanbul": "^4.1.12",
    "ajv": "^8.17.1",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.1"
  },
  "type": "module"
}
