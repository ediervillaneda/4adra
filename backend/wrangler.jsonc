{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "4adra",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // La PWA (spec 2) reemplazará ./public. /api/* siempre pasa por el Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "4adra-db",
      // Se reemplaza por el id real tras `wrangler d1 create 4adra-db` (Deployment.md).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [{ "pattern": "4adra.edier.me", "custom_domain": true }],
  "vars": { "BETTER_AUTH_URL": "https://4adra.edier.me" },
  "observability": { "enabled": true }
}
